# Ignorar archivos de entorno (configuración sensible)
server/.env
server/.env.local
server/.env.*.local

# Ignorar directorio local donde se almacenan los datos de MongoDB
server/data_base/
server/data_base/.mongodb/
server/data_base/diagnostic.data/
server/data_base/journal/

# Ignorar dependencias PHP (Composer)
server/vendor/
server/composer.lock

# Ignorar archivos temporales o de caché
server/src/crud/*.log
server/tmp/
server/cache/

# Ignorar artefactos de logs y cobertura
server/*.log
server/coverage/
server/.cache/
server/.tmp/

# Ignorar archivos de configuración del IDE (VS Code, PHPStorm, etc.)
server/.vscode/
server/.idea/

# Ignorar archivos de sistema
*.DS_Store # macOS
Thumbs.db # Windows

# Ignorar archivos de Docker si no quieres compartir configuraciones locales
server/docker-compose.override.yml
server/docker-compose.prod.yml
server/docker-compose.dev.yml

# Ignorar configuraciones y volúmenes de Docker locales
server/volumes/
server/logs/

# Ignorar configuraciones de pruebas
server/src/test/
