{
  "name": "techzone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run docker-up\" \"npm run start-php\" \"vite\"",
    "docker-up": "docker-compose -f server/docker-compose.yml up -d mongodb",
    "start-php": "php -S localhost:8000 server/src/router.php",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "@auth0/auth0-spa-js": "^2.1.3",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@faker-js/faker": "^8.4.1",
    "@mui/material": "^5.15.20",
    "axios": "^1.7.7",
    "express": "^4.19.2",
    "nodemon": "^3.1.4",
    "random": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^6.20.1",
    "tailwindcss-animated": "^1.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^7.6.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.32",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.0"
  }
}
