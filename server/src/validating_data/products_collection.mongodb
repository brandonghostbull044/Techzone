use("Techzone")

db.createCollection("products", {
    validator: {
        $jsonSchema: {
            bsonType: 'object',
            required: ['name'],
            properties: {
                name: {
                    bsonType: 'string',
                },
                sizes: {
                    bsonType: 'array',
                    minItems: 1,
                    uniqueItems: true,
                    items: {
                        bsonType: 'string'
                    }
                },
                category: {
                    bsonType: 'object',
                    required: ['name', 'id'],
                    properties: {
                        id: {
                            bsonType: 'number'
                        },
                        name: {
                            bsonType: 'string'
                        },
                        img: {
                            bsonType: 'string'
                        }
                    }
                }
            }
        }
    }
})